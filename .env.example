# Copiar a .env (no se versiona) o configurar en App Service → Configuration.
# NUNCA poner valores reales en este archivo.

# --- Azure SQL ---
SQL_URL=jdbc:sqlserver://<servidor>.database.windows.net:1433;databaseName=coredb;encrypt=true;trustServerCertificate=false
SQL_USER=
SQL_PASSWORD=

# --- JWT ---
# Clave en base64 de al menos 32 bytes: openssl rand -base64 48
# El MISMO valor va en APIM (Named value secreto "jwt-signing-key", usado en validate-jwt) y en MS3.
JWT_SECRET=
JWT_TTL_HOURS=8
JWT_ISSUER=skillgrow-core

# --- Google (login con Google) ---
GOOGLE_CLIENT_ID=
# Solo en local: acepta idToken "demo" y entra con la cuenta GOOGLE_DEMO_EMAIL
GOOGLE_DEMO_ENABLED=false
GOOGLE_DEMO_EMAIL=aprendiz@skillgrow.test

# --- Service Bus (eventos hacia MS3) ---
EVENTS_ENABLED=true
SERVICEBUS_CONNECTION=
SERVICEBUS_QUEUE=notifications

# --- Certificado de APIM (mTLS) ---
APIM_CERT_CHECK=true
APIM_CERT_THUMBPRINT=

# --- Catálogo de servicios (MS2) ---
# stub = servicios del seed de la Fase I · http = MS2 a través de APIM
SERVICE_CATALOG_MODE=http
DOMINIO_BASE_URL=https://<apim>.azure-api.net/dominio
APIM_SUBSCRIPTION_KEY=
SERVICE_CATALOG_TIMEOUT_MS=3000

# --- General ---
APP_ZONE=America/Costa_Rica
